# Frontend Dockerfile for Angular (production build with nginx)
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
# Using npm install instead of npm ci since we don't have package-lock.json yet
# For production, consider generating package-lock.json and using npm ci
RUN npm install

# Copy source code
COPY . .

# Build application
RUN npm run build -- --configuration production

# Production stage with nginx
FROM nginx:alpine

# Copy built assets
COPY --from=build /app/dist/exam-frontend /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
