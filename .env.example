# Database Configuration
DB_NAME=exam
DB_USERNAME=exam_user
DB_PASSWORD=exam_password
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=9000
APPLICATION_SECRET=changeme-in-production-use-strong-random-secret

# Frontend Configuration
FRONTEND_PORT=4200

# Development Authentication (NEVER enable in production)
# Set DEV_AUTH_ENABLED=true to bypass Shibboleth/HAKA authentication
DEV_AUTH_ENABLED=false
DEV_AUTH_USER=dev-user

# Optional: Reverse Proxy
# NGINX_PORT=8080

# Production overrides (for production deployments)
# DATABASE_URL=jdbc:postgresql://production-host:5432/exam
# Remove DEV_AUTH_ENABLED or ensure it's false in production
