<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%date{ISO8601} [%level] [%logger] %message%n%xException</pattern>
        </encoder>
    </appender>
    
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
