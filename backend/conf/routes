# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting

GET     /                           controllers.HomeController.index
GET     /health                     controllers.HealthController.check
GET     /api/v1/reports             controllers.ReportController.list(filters: Option[String], page: Option[Int], pageSize: Option[Int])
GET     /api/v1/reports/:id         controllers.ReportController.get(id: Long)
POST    /api/v1/reports             controllers.ReportController.create
PUT     /api/v1/reports/:id         controllers.ReportController.update(id: Long)
DELETE  /api/v1/reports/:id         controllers.ReportController.delete(id: Long)
